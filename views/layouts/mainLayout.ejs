<!DOCTYPE html>
<html lang="es" class="h-full">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#033F73" />

  <link rel="manifest" href="/manifest.json?v=20260520-08" />
  <link rel="icon" type="image/png" href="/assets/icons/icono.png" />

  <!-- Tema inicial antes de pintar la pantalla -->
  <script>
    (function () {
      const storedTheme = localStorage.getItem('color-theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const shouldUseDark = storedTheme === 'dark' || (!storedTheme && systemPrefersDark);

      document.documentElement.classList.toggle('dark', shouldUseDark);
    })();
  </script>

  <!-- Iconos -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <!-- DataTables CSS -->
  <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css" />
  <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.2/css/buttons.dataTables.min.css" />
  <link rel="stylesheet" href="https://cdn.datatables.net/colreorder/2.0.4/css/colReorder.dataTables.min.css" />

  <!-- Estilos propios -->
  <link rel="stylesheet" href="/css/tailwind.css?v=20260520-08" />
  <link rel="stylesheet" href="/css/app.css?v=20260520-08" />

  <title>
    <%= typeof title !=='undefined' ? title : 'Dashboard' %> | Cavallino
  </title>
</head>

<body
  class="min-h-screen overflow-x-hidden bg-[#F2F2F2] text-[#0D0D0D] antialiased dark:bg-[#0f172a] dark:text-slate-100">

  <%- include('../partials/sidebar', { currentSection: typeof currentSection !=='undefined' ? currentSection : '' ,
    currentUser: typeof currentUser !=='undefined' ? currentUser : null }) %>

    <%- include('../partials/topbar', { currentUser: typeof currentUser !=='undefined' ? currentUser : null, pageTitle:
      typeof title !=='undefined' ? title : 'Dashboard' }) %>

      <!--
    Importante:
    pt-20 compensa el topbar fijo.
    lg:pl-64 compensa el sidebar fijo en desktop.
  -->
      <main id="app-main" class="min-h-screen min-w-0 overflow-x-hidden pt-20 lg:pl-64">
        <div class="w-full min-w-0 px-3 pb-6 sm:px-4 lg:px-6">
          <div class="mx-auto w-full max-w-screen-2xl min-w-0 space-y-5">
            <%- body %>
          </div>
        </div>
      </main>

      <!-- Estado de preparación offline -->
      <div id="offline-ready-indicator"
        class="fixed bottom-4 left-3 right-3 z-[9999] hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-2xl dark:border-slate-700 dark:bg-slate-900 sm:left-auto sm:right-4 sm:w-[420px]">

        <div class="flex items-start gap-3">
          <div id="offline-ready-dot" class="mt-1 h-3 w-3 shrink-0 rounded-full bg-slate-400"></div>

          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p id="offline-ready-title" class="text-sm font-bold text-slate-900 dark:text-white">
                  Preparando modo offline
                </p>
                <p id="offline-ready-message" class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                  Verificando datos locales...
                </p>
              </div>

              <button type="button" id="offline-ready-close"
                class="shrink-0 rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-white"
                aria-label="Cerrar estado offline">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>

            <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
              <div id="offline-ready-progress"
                class="h-full w-0 rounded-full bg-sky-600 transition-all duration-300 dark:bg-sky-400"></div>
            </div>

            <div class="mt-2 flex items-center justify-between gap-3 text-[11px] text-slate-400 dark:text-slate-500">
              <span id="offline-ready-counts" class="min-w-0 truncate">—</span>

              <button type="button" id="offline-ready-sync-now"
                class="hidden shrink-0 font-semibold text-sky-700 hover:underline dark:text-sky-300">
                Sincronizar ahora
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Control visual del estado offline -->
      <script>
        (() => {
          const indicator = document.getElementById('offline-ready-indicator');
          const dot = document.getElementById('offline-ready-dot');
          const title = document.getElementById('offline-ready-title');
          const message = document.getElementById('offline-ready-message');
          const progress = document.getElementById('offline-ready-progress');
          const counts = document.getElementById('offline-ready-counts');
          const closeButton = document.getElementById('offline-ready-close');
          const syncNowButton = document.getElementById('offline-ready-sync-now');

          if (!indicator || !dot || !title || !message || !progress || !counts) return;

          let closedManually = false;
          let hideTimer = null;

          function setDot(state) {
            dot.className = 'mt-1 h-3 w-3 shrink-0 rounded-full';

            if (state === 'ready') {
              dot.classList.add('bg-emerald-500');
              return;
            }

            if (state === 'error') {
              dot.classList.add('bg-red-500');
              return;
            }

            if (state === 'offline') {
              dot.classList.add('bg-yellow-500');
              return;
            }

            dot.classList.add('bg-sky-500', 'animate-pulse');
          }

          function setProgress(value) {
            const safeValue = Math.max(0, Math.min(100, Number(value) || 0));
            progress.style.width = `${safeValue}%`;
          }

          function formatCounts(snapshotCounts) {
            if (!snapshotCounts || typeof snapshotCounts !== 'object') return '—';

            const parts = [
              `Pozos: ${snapshotCounts.pozos || 0}`,
              `Parámetros: ${snapshotCounts.parametros || 0}`,
              `Niveles: ${snapshotCounts.niveles || 0}`,
              `Bombas: ${snapshotCounts.bombas || 0}`
            ];

            return parts.join(' · ');
          }

          function show(detail = {}) {
            if (closedManually && detail.state !== 'error') return;

            clearTimeout(hideTimer);

            const state = detail.state || 'loading';

            setDot(state);
            setProgress(detail.progress ?? (state === 'ready' ? 100 : 15));

            if (state === 'ready') {
              title.textContent = 'Listo para usar sin conexión';
              message.textContent = detail.message || 'Los datos quedaron guardados en este dispositivo.';
              counts.textContent = formatCounts(detail.counts);

              hideTimer = setTimeout(() => {
                indicator.classList.add('hidden');
              }, 12000);
            } else if (state === 'error') {
              title.textContent = 'No se pudo preparar offline';
              message.textContent = detail.message || 'Ocurrió un error durante la sincronización local.';
              counts.textContent = 'Revisa la conexión o inicia sesión nuevamente.';
            } else if (state === 'offline') {
              title.textContent = 'Trabajando sin conexión';
              message.textContent = detail.message || 'Usando los datos guardados localmente.';
              counts.textContent = formatCounts(detail.counts);
            } else if (state === 'saving') {
              title.textContent = 'Guardando datos offline';
              message.textContent = detail.message || 'Guardando información en IndexedDB...';
              counts.textContent = formatCounts(detail.counts);
            } else if (state === 'loading') {
              title.textContent = 'Descargando datos offline';
              message.textContent = detail.message || 'Descargando snapshot desde el servidor...';
              counts.textContent = 'Esto puede tardar unos segundos la primera vez.';
            } else if (state === 'syncing-queue') {
              title.textContent = 'Sincronizando cambios pendientes';
              message.textContent = detail.message || 'Enviando cambios guardados localmente...';
              counts.textContent = formatCounts(detail.counts);
            } else if (state === 'queued') {
              title.textContent = 'Cambio guardado localmente';
              message.textContent = detail.message || 'Se sincronizará cuando vuelva la conexión.';
              counts.textContent = detail.queueLength ? `Pendientes: ${detail.queueLength}` : 'Pendiente de sincronizar.';
            } else if (state === 'idle-online' || state === 'online') {
              title.textContent = 'Preparando modo offline';
              message.textContent = detail.message || 'Con conexión. Verificando datos locales...';
              counts.textContent = formatCounts(detail.counts);
            } else if (state === 'busy') {
              title.textContent = 'Sincronización en proceso';
              message.textContent = detail.message || 'Ya hay una sincronización offline activa.';
              counts.textContent = formatCounts(detail.counts);
            } else {
              title.textContent = 'Preparando modo offline';
              message.textContent = detail.message || 'Verificando datos locales...';
              counts.textContent = formatCounts(detail.counts);
            }

            syncNowButton?.classList.toggle('hidden', !navigator.onLine);

            indicator.classList.remove('hidden');
          }

          closeButton?.addEventListener('click', () => {
            closedManually = true;
            indicator.classList.add('hidden');
          });

          syncNowButton?.addEventListener('click', async () => {
            closedManually = false;

            if (!window.PetroSync?.syncNow) {
              show({
                state: 'error',
                message: 'PetroSync no está disponible.',
                progress: 0
              });
              return;
            }

            show({
              state: 'loading',
              message: 'Sincronizando manualmente...',
              progress: 10
            });

            await window.PetroSync.syncNow({ force: true });
          });

          window.addEventListener('petro:offline-status', (event) => {
            show(event.detail || {});
          });

          window.addEventListener('petro:offline-updated', (event) => {
            localStorage.setItem('petro-offline-ready', '1');
            localStorage.setItem('petro-offline-ready-at', new Date().toISOString());

            show({
              state: 'ready',
              message: 'PetroField quedó preparado para trabajar sin conexión.',
              progress: 100,
              counts: event.detail?.counts
            });
          });

          window.addEventListener('petro:offline-queue-updated', (event) => {
            const queueLength = event.detail?.queueLength || 0;

            if (queueLength > 0) {
              closedManually = false;

              show({
                state: 'queued',
                message: `Tienes ${queueLength} cambio(s) pendiente(s) por sincronizar.`,
                queueLength,
                progress: 100
              });
            }
          });

          window.addEventListener('online', () => {
            closedManually = false;
            syncNowButton?.classList.remove('hidden');

            show({
              state: 'online',
              message: 'Conexión recuperada. Verificando modo offline...',
              progress: 10
            });
          });

          window.addEventListener('offline', () => {
            closedManually = false;

            show({
              state: 'offline',
              message: 'Sin conexión. Se usarán los datos guardados localmente.',
              progress: localStorage.getItem('petro-offline-ready') === '1' ? 100 : 0
            });
          });

          /**
           * Prueba visual automática suave:
           * Si el usuario está online y aún no se ha marcado offline-ready,
           * mostramos el indicador desde el layout mientras sync.js termina de cargar.
           */
          window.addEventListener('DOMContentLoaded', () => {
            if (navigator.onLine && localStorage.getItem('petro-offline-ready') !== '1') {
              show({
                state: 'idle-online',
                message: 'Con conexión. Preparando datos offline...',
                progress: 5
              });
            }
          });
        })();
      </script>

      <!-- Librerías base -->
      <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

      <!-- ApexCharts -->
      <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

      <!-- Flowbite -->
      <script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>

      <!-- DataTables -->
      <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>

      <!-- DataTables Buttons -->
      <script src="https://cdn.datatables.net/buttons/3.2.2/js/dataTables.buttons.min.js"></script>
      <script src="https://cdn.datatables.net/buttons/3.2.2/js/buttons.html5.min.js"></script>

      <!-- DataTables ColReorder -->
      <script src="https://cdn.datatables.net/colreorder/2.0.4/js/dataTables.colReorder.min.js"></script>

      <!-- Dependencia para exportar Excel -->
      <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

      <!-- Scripts offline/core con cache-busting -->
      <script src="/js/offline/db.js?v=20260520-08"></script>
      <script src="/js/offline/store.js?v=20260520-08"></script>
      <script src="/js/offline/sync.js?v=20260520-08"></script>
      <script src="/js/offline/status.js?v=20260520-08"></script>

      <!-- Scripts core con cache-busting -->
      <script src="/js/core/ui.js?v=20260520-08"></script>
      <script src="/js/core/app.js?v=20260520-08"></script>
      <script src="/js/sw-register.js?v=20260520-08"></script>
      <script src="/js/app-theme.js?v=20260520-08"></script>

      <!-- Script específico de cada página -->
      <% if (typeof pageScript !=='undefined' && pageScript) { %>
        <script src="<%= pageScript %>?v=20260520-08"></script>
        <% } %>

</body>

</html>