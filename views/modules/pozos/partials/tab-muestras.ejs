<% const pozoSafe=typeof pozo !=='undefined' && pozo ? pozo : {}; const codigoPozo=pozoSafe.codigo || pozoSafe.nombre
  || 'pozo' ; const idPozo=pozoSafe.id || '' ; const timelineSafe=typeof timeline !=='undefined' && timeline ? timeline
  : {}; const muestras=typeof ultimasMuestras !=='undefined' && Array.isArray(ultimasMuestras) ? ultimasMuestras : (
  Array.isArray(timelineSafe.muestras) ? timelineSafe.muestras : [] ); function getDateKey(value) { if (!value)
  return '' ; if (value instanceof Date && !Number.isNaN(value.getTime())) { const year=value.getFullYear(); const
  month=String(value.getMonth() + 1).padStart(2, '0' ); const day=String(value.getDate()).padStart(2, '0' ); return
  `${year}-${month}-${day}`; } const text=String(value).trim(); const isoMatch=text.match(/^(\d{4}-\d{2}-\d{2})/); if
  (isoMatch) return isoMatch[1]; const parsed=new Date(text); if (!Number.isNaN(parsed.getTime())) { const
  parsedYear=parsed.getFullYear(); const parsedMonth=String(parsed.getMonth() + 1).padStart(2, '0' ); const
  parsedDay=String(parsed.getDate()).padStart(2, '0' ); return `${parsedYear}-${parsedMonth}-${parsedDay}`; } return ''
  ; } function normalizeText(value) { return String(value ?? '' ) .trim() .toLowerCase() .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '' ); } function isMuestraRepresentativa(value) { const normalized=normalizeText(value);
  return ( value===true || value===1 || normalized==='1' || normalized==='true' || normalized==='si' ||
  normalized==='yes' || normalized==='representativa' ); } %>

  <div id="tab-muestras-pozo"
    class="space-y-4 rounded-2xl bg-slate-50 p-3 text-slate-900 dark:bg-slate-950 dark:text-slate-100 sm:p-4">

    <!-- =========================================================
       TABLA MUESTRAS
       ========================================================= -->
    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
      <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
            Muestras
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400">
            Histórico de muestras registradas para este pozo. Marca como representativas las muestras que quieras ver en
            la gráfica.
          </p>
        </div>

        <button type="button" data-pozo-action="nueva-muestra" data-pozo-id="<%= idPozo %>"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#033F73] px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-[#022f56]">
          <i class="fa-solid fa-plus"></i>
          Nueva muestra
        </button>
      </div>

      <script type="application/json"
        id="muestras-data-json"><%- JSON.stringify(muestras).replace(/</g, '\\u003c') %></script>

      <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">
        <table id="tabla-muestras-pozo"
          class="w-full min-w-[900px] text-left text-sm text-slate-600 dark:text-slate-300">
          <thead class="bg-slate-50 text-xs uppercase text-slate-700 dark:bg-slate-800 dark:text-slate-300">
            <tr>
              <th class="px-4 py-3">Fecha</th>
              <th class="px-4 py-3">% AyS</th>
              <th class="px-4 py-3">API</th>
              <th class="px-4 py-3">Próx. muestra</th>
              <th class="px-4 py-3">Acción</th>
              <th class="px-4 py-3 text-center">Representativa</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <% if (muestras.length) { %>
              <% muestras.forEach(function(muestra, index) { const muestraId=muestra.id || muestra.id_muestra ||
                muestra.id_muestras || muestra.muestra_id || '' ; const fechaIso=getDateKey(muestra.fecha); const
                proxMuestra=muestra.prox_muestra || muestra.proxima_muestra; const proxIso=getDateKey(proxMuestra);
                const aysValue=muestra.ays !=null && muestra.ays !=='' ? muestra.ays : muestra.porcentaje_ays; const
                apiValue=muestra.api !=null && muestra.api !=='' ? muestra.api : muestra.gravedad_api; const
                representativaRaw=muestra.representativa !=null ? muestra.representativa : ( muestra.es_representativa
                !=null ? muestra.es_representativa : muestra.muestra_representativa ); const
                isRepresentativa=isMuestraRepresentativa(representativaRaw); %>
                <tr
                  class="<%= index % 2 === 0 ? 'bg-white dark:bg-slate-900' : 'bg-slate-50/70 dark:bg-slate-800/40' %> hover:bg-slate-50 dark:hover:bg-slate-800/70">

                  <td class="whitespace-nowrap px-4 py-3 font-semibold text-slate-900 dark:text-white"
                    data-order="<%= fechaIso %>">
                    <%= fallback(formatDate(muestra.fecha)) %>
                  </td>

                  <td class="whitespace-nowrap px-4 py-3 font-medium text-slate-700 dark:text-slate-200"
                    data-order="<%= aysValue != null ? aysValue : '' %>">
                    <%= aysValue !=null && aysValue !=='' ? fallback(formatNumber(aysValue, 2)) : '—' %>
                  </td>

                  <td class="whitespace-nowrap px-4 py-3" data-order="<%= apiValue != null ? apiValue : '' %>">
                    <%= apiValue !=null && apiValue !=='' ? fallback(formatNumber(apiValue, 2)) : '—' %>
                  </td>

                  <td class="whitespace-nowrap px-4 py-3" data-order="<%= proxIso %>">
                    <%= fallback(formatDate(proxMuestra)) %>
                  </td>

                  <td class="whitespace-nowrap px-4 py-3">
                    <button type="button" data-pozo-action="editar-muestra" data-pozo-id="<%= idPozo %>"
                      data-muestra-id="<%= muestraId %>"
                      class="inline-flex items-center gap-1.5 font-medium text-[#033F73] hover:underline dark:text-sky-300">
                      <i class="fa-solid fa-pen-to-square text-xs"></i>
                      Editar
                    </button>
                  </td>

                  <td class="whitespace-nowrap px-4 py-3 text-center" data-order="<%= isRepresentativa ? 1 : 0 %>">

                    <label class="inline-flex cursor-pointer select-none items-center justify-center gap-2">
                      <input type="checkbox" class="peer sr-only" data-muestra-representativa="true"
                        data-muestra-id="<%= muestraId %>" data-pozo-id="<%= idPozo %>" data-fecha="<%= fechaIso %>"
                        data-ays="<%= aysValue != null ? aysValue : '' %>" <%=isRepresentativa ? 'checked' : '' %>>

                      <span
                        class="relative h-6 w-11 shrink-0 rounded-full bg-slate-300 transition after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition peer-checked:bg-emerald-600 peer-checked:after:translate-x-5 dark:bg-slate-700">
                      </span>

                      <span data-muestra-switch-label
                        class="min-w-[18px] text-left text-xs font-semibold <%= isRepresentativa ? 'text-emerald-700 dark:text-emerald-300' : 'text-slate-500 dark:text-slate-400' %>">
                        <%= isRepresentativa ? 'Sí' : 'No' %>
                      </span>
                    </label>
                  </td>
                </tr>
                <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="px-4 py-6 text-center text-slate-500 dark:text-slate-400">
                        No hay muestras registradas.
                      </td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- =========================================================
       GRAFICA MUESTRAS
       ========================================================= -->
    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
      <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
            Gráfica de muestras representativas
          </h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Comportamiento de agua y sedimentos (% AyS) en el tiempo.
          </p>
        </div>

        <button type="button" data-export-chart="chart-muestras-pozo" data-export-name="muestras-<%= codigoPozo %>"
          data-export-pozo="<%= codigoPozo %>" data-export-kind="muestras"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-amber-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-amber-700">
          <i class="fa-solid fa-download"></i>
          Exportar PNG
        </button>
      </div>

      <div
        class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-2 dark:border-slate-600 dark:bg-slate-950/70">
        <div id="chart-muestras-pozo"
          class="min-h-[320px] rounded-lg bg-white text-slate-700 dark:bg-slate-950 dark:text-slate-200">
          <% if (!muestras.length) { %>
            <div class="flex min-h-[300px] items-center justify-center">
              <p class="text-sm text-slate-500 dark:text-slate-400">
                No hay muestras disponibles para graficar.
              </p>
            </div>
            <% } else { %>
              <div class="flex min-h-[300px] items-center justify-center">
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  Marca una o más muestras como representativas para graficar % AyS.
                </p>
              </div>
              <% } %>
        </div>
      </div>
    </section>

  </div>